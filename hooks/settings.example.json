{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/chokepoint-hook --policy /ABSOLUTE/PATH/TO/chokepoint-policy.yaml --log-file /ABSOLUTE/PATH/TO/chokepoint-decisions.jsonl"
          }
        ]
      },
      {
        "matcher": "^(Read|Write|Edit|NotebookEdit|Bash|WebFetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/chokepoint-hook --policy /ABSOLUTE/PATH/TO/chokepoint-policy.yaml --log-file /ABSOLUTE/PATH/TO/chokepoint-decisions.jsonl"
          }
        ]
      }
    ]
  }
}
